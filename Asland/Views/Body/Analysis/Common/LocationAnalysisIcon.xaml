<UserControl x:Class="Asland.Views.Body.Analysis.Common.LocationAnalysisIcon"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:converters="clr-namespace:Asland.Common.Converters"
             xmlns:local="clr-namespace:Asland.Views.Body.Analysis.Common"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">

    <UserControl.Resources>
        <converters:PresenceToBrushConverter x:Key="PresenceConverter"/>
        <converters:PercentageConverter x:Key="PercentageConverter"/>
    </UserControl.Resources>

    <StackPanel Orientation="Vertical">
        <Border  Width="180"
                 BorderBrush="{StaticResource StdDataEntryBackgroundColour}"
                 BorderThickness="1">
            <TextBlock 
                    Grid.Row="0"
                    FontWeight="Bold"
                    HorizontalAlignment="Center"
                    Text="{Binding Path=Name}"/>
        </Border>

        <Border  Width="180"
                 BorderBrush="{StaticResource StdDataEntryBackgroundColour}"
                 BorderThickness="1">
                <TextBlock 
                    Background="ForestGreen"
                    Grid.Column="0"
                    FontWeight="Bold"
                    HorizontalAlignment="Center"
                    Text="{Binding Path=Count}"/>
        </Border>
    </StackPanel>
</UserControl>
