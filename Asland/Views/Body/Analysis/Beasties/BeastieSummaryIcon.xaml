<UserControl x:Class="Asland.Views.Body.Analysis.Beasties.BeastieSummaryIcon"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Asland.Views.Body.Analysis.Beasties"
             xmlns:converters="clr-namespace:Asland.Common.Converters"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">

    <UserControl.Resources>
        <converters:PresenceToBrushConverter x:Key="PresenceConverter"/>
    </UserControl.Resources>

    <Grid Background="{Binding Path=Presence, Converter={StaticResource PresenceConverter}}"
          Width="275"
          Height="130">
        <Grid.RowDefinitions>
            <RowDefinition Height="1.5*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock 
            Grid.Row="0"
            FontWeight="Bold"
            FontSize="20"
            HorizontalAlignment="Center"
            Text="{Binding Path=CommonName}"/>

        <Image 
                Grid.Row="1"
                Width="100"
                Height="80"
                Source="{Binding Path=ImagePath}"/>

        <TextBlock 
                Grid.Row="2"
                FontStyle="Italic"
                HorizontalAlignment="Center"
                Text="{Binding Path=LatinName}"/>

    </Grid>
</UserControl>