<UserControl x:Class="Asland.Views.Body.Analysis.Beasties.BeastieSummary"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:common="clr-namespace:Asland.Views.Body.Analysis.Common"
             xmlns:local="clr-namespace:Asland.Views.Body.Analysis.Beasties"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*"/>
            <ColumnDefinition Width="5*"/>
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0">
            <TextBlock Text="{Binding Path=Name}" 
                       Foreground="{StaticResource StdForeground}"
                       TextWrapping="Wrap"
                       FontSize="20"
                       Margin="5"
                       HorizontalAlignment="Center"/>

            <local:BeastieSummaryIcon DataContext="{Binding Path=BeastieIcon}"/>

            <TextBlock Text="Years" 
               Foreground="{StaticResource StdForeground}"
               FontSize="16"
               Margin="5,10,5,5"
               HorizontalAlignment="Center"/>
            <ScrollViewer Background="Transparent"
                         Margin="5"
                         MaxHeight="600"
                         VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding Path=Years}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Vertical"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <common:CommonCounterIcon/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <TextBlock Text="Met Seasons" 
               Foreground="{StaticResource StdForeground}"
               FontSize="16"
               Margin="5,10,5,5"
               HorizontalAlignment="Center"/>
            <ScrollViewer Background="Transparent"
                         Margin="5"
                         MaxHeight="600"
                         VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding Path=MeteorologicalSeasons}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Vertical"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <common:CommonCounterIcon/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <TextBlock Text="Intensity" 
                Foreground="{StaticResource StdForeground}"
                FontSize="16"
                Margin="5,10,5,5"
                HorizontalAlignment="Center"/>
            <ScrollViewer Background="Transparent"
                          Margin="5"
                          MaxHeight="150"
                          VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding Path=Intensities}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Vertical"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <common:CommonCounterIcon/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <TextBlock Text="Habitats" 
                Foreground="{StaticResource StdForeground}"
                FontSize="16"
                Margin="5,10,5,5"
                HorizontalAlignment="Center"/>
            <ScrollViewer Background="Transparent"
                          Margin="5"
                          MaxHeight="150"
                          VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding Path=Habitats}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Vertical"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <common:CommonCounterIcon/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </StackPanel>
    </Grid>
    
</UserControl>
